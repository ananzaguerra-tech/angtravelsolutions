{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://angtravelsolutions.com.br/schemas/destination-batch.schema.json",
  "title": "ANG destination content batch",
  "type": "object",
  "required": ["schema_version", "status", "destinations"],
  "additionalProperties": true,
  "properties": {
    "schema_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+$"},
    "status": {"const": "draft_for_staging"},
    "editorial_standard": {"type": "string"},
    "destinations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["country", "currency", "languages", "voltage", "best_time", "cities"],
        "properties": {
          "country": {"type": "string", "minLength": 1},
          "currency": {"type": "string", "minLength": 1},
          "languages": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "voltage": {"type": "string", "minLength": 1},
          "best_time": {"type": "string", "minLength": 1},
          "cities": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["name", "summary", "attractions", "premium_experiences"],
              "properties": {
                "name": {"type": "string", "minLength": 1},
                "summary": {"type": "string", "minLength": 20},
                "attractions": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
                "premium_experiences": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
              },
              "additionalProperties": true
            }
          }
        },
        "additionalProperties": true
      }
    }
  }
}
