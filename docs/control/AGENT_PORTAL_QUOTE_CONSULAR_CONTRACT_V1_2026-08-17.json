{
  "version": "1.0",
  "scope": "agent portal quotations",
  "principle": "Consular data belongs to the quotation generated by the travel agent in the portal. Concierge may surface the same information contextually during service when relevant, but it is not a mandatory conversational checklist for every interaction.",
  "quote_required_inputs": [
    "destination_country",
    "travel_dates",
    "passenger_nationality",
    "passenger_count",
    "minor_present",
    "minor_ages_if_any"
  ],
  "quote_required_consular_output": [
    "visa_or_electronic_authorization",
    "passport_or_travel_document_validity",
    "maximum_stay_or_entry_conditions",
    "vaccines_and_health_requirements",
    "travel_insurance_requirement_if_applicable",
    "proof_of_funds_or_accommodation_if_applicable",
    "minor_travel_authorization_requirements",
    "customs_and_currency_notes_if_material",
    "official_sources",
    "checked_at"
  ],
  "source_policy": {
    "brazilian_outbound": ["destination immigration/consular authority", "Brazil MRE Portal Consular"],
    "foreign_inbound_brazil": ["Brazil MRE/consular network", "Brazil Federal Police immigration"]
  },
  "rendering": {
    "pdf": true,
    "share_link": true,
    "agent_console": true,
    "customer_visible": true,
    "section_title": "Documentação, vistos, saúde e requisitos de viagem"
  },
  "concierge_behavior": {
    "mandatory_on_every_message": false,
    "surface_when_relevant": true,
    "triggers": ["documentation_question", "visa_question", "vaccine_question", "minor_travel", "pre_departure_check", "border_entry_issue", "travel_quote_followup"]
  },
  "safety": {
    "never_invent_requirement": true,
    "dynamic_fields_require_revalidation": true,
    "store_source_and_checked_at": true
  }
}
