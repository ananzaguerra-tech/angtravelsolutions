{
  "schema_version": "1.0",
  "status": "MANDATORY_STAGING_GATE",
  "scope": "all destination country pages and Brazil inbound curation",
  "traveler_flows": {
    "brazilian_outbound": {
      "nationality": "Brazilian",
      "required_fields": [
        "visa_requirement_for_brazilian_passport",
        "maximum_tourist_stay",
        "passport_validity_rule",
        "blank_pages_if_required",
        "onward_return_ticket_requirement",
        "proof_of_accommodation_requirement",
        "proof_of_financial_means_requirement",
        "travel_insurance_requirement",
        "vaccination_health_entry_rules",
        "electronic_travel_authorization_or_pre_registration",
        "biometric_entry_exit_systems",
        "customs_currency_rules",
        "local_driving_document_rules",
        "minor_travel_rules",
        "embassy_consulate_of_destination_country_in_brazil",
        "brazilian_embassy_consulate_at_destination",
        "emergency_consular_guidance",
        "official_sources",
        "checked_at"
      ],
      "source_priority": [
        "destination-country immigration/foreign ministry/embassy",
        "Brazil Ministry of Foreign Affairs Portal Consular",
        "Brazilian embassy/consulate at destination"
      ]
    },
    "foreign_inbound_brazil": {
      "destination": "Brazil",
      "required_fields": [
        "traveler_nationality",
        "visa_or_exemption_status",
        "maximum_stay",
        "passport_or_travel_document_rules",
        "visa_application_channel_if_required",
        "entry_migration_requirements",
        "onward_return_ticket_requirement_if_applicable",
        "proof_of_accommodation_requirement_if_applicable",
        "proof_of_financial_means_requirement_if_applicable",
        "vaccination_health_rules",
        "customs_currency_rules",
        "minor_travel_rules",
        "brazilian_consular_post_for_origin_country",
        "policia_federal_migration_reference",
        "official_sources",
        "checked_at"
      ],
      "source_priority": [
        "Brazil Ministry of Foreign Affairs",
        "Brazilian consular representation in traveler country",
        "Brazil Federal Police migration guidance"
      ]
    }
  },
  "dynamic_rule": "Consular, immigration, visa, health and entry requirements are dynamic. Revalidate near publication and near travel. Never present stale data as current. Store source URL and checked_at for every dynamic field.",
  "publication_gate": {
    "consular_complete": "PASS",
    "official_sources_min": 2,
    "dynamic_fields_revalidated": true,
    "legal_disclaimer": "Information is operational guidance based on official sources; final admission decision belongs to the competent immigration authority."
  }
