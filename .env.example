# Copy locally to .env and fill values in the deployment environment.
# Never commit real credentials.

APP_ENV=development
SITE_URL=https://staging.example.invalid
MCP_BASE_URL=https://mcp.example.invalid
ANG_CONNECT_BASE_URL=http://localhost:8088
N8N_BASE_URL=https://n8n.example.invalid
WORDPRESS_BASE_URL=https://staging.example.invalid

# Secret values must be injected by the hosting platform.
MCP_BEARER_TOKEN=
N8N_ROUTER_TOKEN=
WORDPRESS_APP_USER=
WORDPRESS_APP_PASSWORD=
ROBOT_BRIDGE_TOKEN=

REQUIRE_PRODUCTION_CONFIRMATION=true
ALLOW_PRODUCTION_PROMOTION=false
